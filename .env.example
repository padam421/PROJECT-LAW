# ---- Server ----
PORT=3000
# Use a long random value in production (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-to-a-long-random-string

# ---- Verification-desk admin bootstrap ----
ADMIN_EMAIL=admin@legalconnect.in
ADMIN_PASSWORD=Admin@1234

# ---- Demo data: keep FALSE in real deployments ----
SEED_DEMO_DATA=false

# ---- Outbound email (real OTP & password-reset delivery) ----
# Gmail example: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
# SMTP_PASS must be a Google **App Password** (account → security → 2-step verification → app passwords)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LegalConnect <you@gmail.com>

# Public base URL used inside emails (password-reset links)
APP_BASE_URL=http://localhost:3000

# ---- AI microservice (planned client-side features) ----
AI_SERVICE_URL=http://localhost:5000

# ---- Optional tuning ----
# BCRYPT_ROUNDS=10
# MAX_UPLOAD_MB=10
# NODE_ENV=production
