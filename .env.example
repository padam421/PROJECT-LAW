# ============================================================
# LEGALCONNECT — ENVIRONMENT CONFIGURATION
# Copy to `.env` and fill in real values.
# ============================================================

PORT=3000
# NODE_ENV=production            # set ONLY on a real deployment (enables fail-fast checks + secure cookies)

# --- Session security (REQUIRED) ---
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10

# --- Verification-desk admin bootstrap ---
ADMIN_EMAIL=admin@legalconnect.in
ADMIN_PASSWORD=                  # REQUIRED in production — no defaults are used

# --- Demo data seeding: leave FALSE for real usage ---
SEED_DEMO_DATA=false

# ============================================================
# TRANSACTIONAL EMAIL — configure any ONE channel.
# Priority: Resend → Brevo → SendGrid → SMTP.
# All deliver to Gmail/Yahoo/Outlook/custom domains worldwide.
# ============================================================

# 1) RESEND (resend.com) — simplest. Verify your domain, then:
RESEND_API_KEY=
# MAIL_FROM must use a domain verified in your Resend dashboard:
MAIL_FROM=LegalConnect <no-reply@yourdomain.com>

# 2) BREVO (brevo.com, ex-Sendinblue) — 300 free emails/day:
BREVO_API_KEY=

# 3) SENDGRID (sendgrid.com) — 100 free emails/day:
SENDGRID_API_KEY=

# 4) SMTP via nodemailer (Gmail: needs a 2-Step-Verification App Password)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Fallback sender used by API channels when MAIL_FROM is empty
# and by SMTP always:
# MAIL_FROM=LegalConnect <you@gmail.com>

# --- Public base URL used inside emails (reset links) ---
APP_BASE_URL=http://localhost:3000

# --- Session cookie hardening (production) ---
# COOKIE_SECURE=true              # HTTPS-only cookies (auto-on when NODE_ENV=production)
# COOKIE_SAMESITE=lax

AI_SERVICE_URL=http://localhost:5000
